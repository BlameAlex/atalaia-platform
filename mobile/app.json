{
  "expo": {
    "name": "AtalaIA",
    "slug": "atalaia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atalaia",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-location", {"locationWhenInUsePermission": "Permite el acceso a tu ubicación para que el equipo de rescate te encuentre. Si no, usaremos tu domicilio."}],
      ["expo-splash-screen", {"backgroundColor": "#208AEF", "image": "./assets/images/splash-icon.png", "imageWidth": 76}]
    ],
    "experiments": {}
  }
}
